{
  "normal": {
    "center_subdivision": [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5],
    "block_subdivision": [0.0, 0.5, 1.0]
  },
  "visualization": {
    "num": 160,
    "mode": "surface",
    "value": "density",
    "fallback_html": "bgd_visualization.html",
    "show": true,
    "loop_template": {
      "enabled": true,
      "num": 160,
      "mode": "heatmap",
      "value": "cell_mass",
      "tail_blocks": 2,
      "show_internal_grid": true,
      "fallback_html": "bgd_loop_template_w{loop}.html",
      "show": true
    }
  },
  "template": {
    "loop_unroll_iterations": 2,
    "dirac_iterations": 2,
    "uniform_convolution_max_interval": 0.1
  },
  "solver": {
    "name": "rust",
    "ipopt": {
      "max_iter": 500,
      "tol": 1e-6,
      "constraint_eps": 1e-8,
      "smooth_max_eps": 0.0,
      "fd_eps": 1e-6,
      "print_level": 0,
      "compile_expr": true,
      "profile": true
    },
    "rust": {
      "diabolo_dir": "diabolo",
      "bin_name": "solve_json",
      "release": false,
      "max_iter": 500,
      "tol": 1e-6,
      "constraint_eps": 1e-8,
      "constraint_margin": 0.0,
      "verbose": false,
      "preprocess": false,
      "save_problem": null
    }
  }
}
