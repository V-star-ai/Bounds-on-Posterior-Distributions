{
  "normal": {
    "center_subdivision": [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5],
    "block_subdivision": [0.0, 0.5, 1.0]
  },
  "visualization": {
    "num": 160,
    "mode": "surface",
    "value": "density",
    "fallback_html": "bgd_visualization.html",
    "show": true
  },
  "template": {
    "dirac_iterations": 2,
    "uniform_convolution_max_interval": 0.5
  },
  "solver": {
    "name": "ipopt",
    "ipopt": {
      "max_iter": 500,
      "tol": 1e-6,
      "constraint_eps": 1e-8,
      "smooth_max_eps": 0.0,
      "fd_eps": 1e-6,
      "print_level": 0,
      "compile_expr": true,
      "profile": true
    }
  }
}
